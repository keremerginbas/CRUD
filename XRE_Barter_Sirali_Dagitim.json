        "jsCode": "const dv = $('Barter Verisi Hazırla').item.json;\nconst fields = Object.assign({}, dv.body.fields);\n\nlet contactId = '';\nlet found = null;\ntry { found = $('Kişi Ara').item.json.result; } catch(e){}\n\nif (found && found.CONTACT && found.CONTACT.length) {\n  contactId = found.CONTACT[0];\n} else {\n  try { contactId = $('Kişi Oluştur').item.json.result; } catch(e){}\n}\n\nif (contactId && (typeof contactId === 'number' || /^\\d+$/.test(String(contactId)))) {\n  fields['CONTACT_ID'] = contactId;\n}\n\nreturn { json: {\n  row_number: dv.row_number,\n  body: { fields: fields, params: { REGISTER_SONET_EVENT: 'Y' } }\n} };"

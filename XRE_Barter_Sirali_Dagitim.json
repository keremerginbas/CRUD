    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\n\nfunction clean(v) {\n  return String(v ?? '').replace(/\\u00A0/g, ' ').replace(/\\s+/g, ' ').trim();\n}\nfunction norm(s) {\n  return clean(s)\n    .replace(/²/g, '2')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .toUpperCase()\n    .replace(/[:：]/g, '')\n    .replace(/[^A-Z0-9]+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\nfunction filled(v) {\n  return v !== undefined && v !== null && clean(v) !== '';\n}\n\nconst entries = Object.entries(r).map(([key, value]) => ({\n  key, nkey: norm(key), value\n}));\n\nfunction g(...names) {\n  const wanted = names.map(norm).filter(Boolean);\n\n  for (let i = entries.length - 1; i >= 0; i--) {\n    const e = entries[i];\n    if (!filled(e.value)) continue;\n    if (wanted.includes(e.nkey)) return clean(e.value);\n  }\n\n  for (let i = entries.length - 1; i >= 0; i--) {\n    const e = entries[i];\n    if (!filled(e.value)) continue;\n    if (wanted.some(w =>\n      e.nkey === w + ' 2' ||\n      e.nkey === w + '2' ||\n      e.nkey.startsWith(w + ' ')\n    )) return clean(e.value);\n  }\n\n  return '';\n}\n\nfunction normalizeTRPhone(v) {\n  let d = clean(v).replace(/\\D/g, '');\n  if (d.startsWith('0090')) d = d.slice(2);\n  if (d.length === 11 && d.startsWith('05')) d = '9' + d;\n  if (d.length === 10 && d.startsWith('5')) d = '90' + d;\n  const valid = /^905\\d{9}$/.test(d);\n  return { valid, digits: d, plus: valid ? '+' + d : '' };\n}\n\nfunction parseNumberTR(v) {\n  let s = clean(v).replace(/[^\\d.,-]/g, '');\n  if (!s) return 0;\n\n  if (s.includes(',') && s.includes('.')) {\n    s = s.replace(/\\./g, '').replace(',', '.');\n  } else if (s.includes(',')) {\n    s = s.replace(',', '.');\n  } else if (s.includes('.')) {\n    const p = s.split('.');\n    if (p.length > 2 || (p.length === 2 && p[1].length === 3)) {\n      s = s.replace(/\\./g, '');\n    }\n  }\n\n  const n = Number(s);\n  return Number.isFinite(n) ? n : 0;\n}\n\n// Sheet alanları\nconst ilanNo       = g('İlan No', 'İlan Numarası', 'İlan ID').replace(/\\.0+$/, '');\nconst ilanBasligi  = g('İlan Başlığı', 'Başlık');\nconst fiyat        = g('Fiyat (TL)', 'Fiyat', 'Satış Fiyatı');\nconst adaNo        = g('Ada No', 'Ada', 'Ada Numarası');\nconst parselNo     = g('Parsel No', 'Parsel', 'Parsel Numarası');\nconst m2           = g('m²', 'm2', 'Net m²', 'Net m2');\nconst m2Fiyati     = g('m² Fiyatı', 'm2 Fiyatı', 'Metrekare Fiyatı');\nconst tapuDurumu   = g('Tapu Durumu', 'Tapu', 'Tapu Tipi');\nconst magazaAdi    = g('Mağaza Adı', 'Mağaza');\nconst isim         = g('İsim', 'Ad Soyad', 'Satıcı');\nconst telefonRaw   = g('Telefon Numarası', 'Telefon', 'Cep Telefonu', 'GSM');\nconst il           = g('İl', 'Şehir');\nconst ilce         = g('İlçe');\nconst mahalle      = g('Mahalle', 'Mahalle / Mevki');\nconst takas        = g('Takas');\nconst ilanLinkRaw  = g('RESMİ İLAN LİNKİ', 'Resmi İlan Linki', 'RESMI ILAN LINKI', 'İlan Link', 'İlan Linki', 'Link', 'URL');\nconst sorumluKisi  = g('Sorumlu Kişi');\n\nconst phone = normalizeTRPhone(telefonRaw);\n\nlet fullLink = clean(ilanLinkRaw);\nif (fullLink && !/^https?:\\/\\//i.test(fullLink)) {\n  fullLink = 'https://www.sahibinden.com' +\n    (fullLink.startsWith('/') ? '' : '/') + fullLink;\n}\n\n// Sorumlu kişi: sheet'teki 'Sorumlu Kişi' sütununa göre (sıra sıra dağıtım)\nconst SORUMLULAR = [\n  { id: 25314, ad: 'Hatice Aldemir' },\n  { id: 27876, ad: 'Yiğitcan Dilek' },\n  { id: 27878, ad: 'Aleyna Özdemir' }\n];\nlet sorumlu = SORUMLULAR.find(s => norm(s.ad) === norm(sorumluKisi))\n  || SORUMLULAR.find(s => sorumluKisi && norm(s.ad).startsWith(norm(sorumluKisi).split(' ')[0]));\nif (!sorumlu) {\n  // Sütun boşsa / tanınmazsa satır numarasına göre sıra sıra ata\n  const rn = Number(r.row_number || 2);\n  sorumlu = SORUMLULAR[((rn - 2) % SORUMLULAR.length + SORUMLULAR.length) % SORUMLULAR.length];\n}\nconst assignedById = sorumlu.id;\n\nconst np = clean(isim || 'Bilinmeyen Satıcı').split(' ').filter(Boolean);\nconst adi = np.shift() || 'Bilinmeyen';\nconst soyadi = np.join(' ') || 'Satıcı';\n\nlet dealFields = {};\ntry {\n  dealFields = $('Bitrix Deal Alanlarını Oku').first().json.result || {};\n} catch (e) {}\n\nfunction rawLabels(def, id) {\n  const a = [];\n  if (def && typeof def === 'object') {\n    for (const k of ['listLabel', 'formLabel', 'filterLabel']) {\n      if (def[k]) a.push(clean(def[k]));\n    }\n  }\n  a.push(clean(id));\n  return a.filter(Boolean);\n}\n\nfunction fieldExact(exactLabels, fallbackNormalized = []) {\n  // 1) Ekrandaki yazıyla birebir eşleşme\n  for (const wanted of exactLabels) {\n    for (const [id, def] of Object.entries(dealFields)) {\n      if (!String(id).startsWith('UF_CRM_')) continue;\n      if (rawLabels(def, id).includes(wanted)) return id;\n    }\n  }\n\n  // 2) Büyük/küçük harf farkı\n  for (const wanted of exactLabels) {\n    const w = wanted.toLocaleLowerCase('tr-TR');\n    for (const [id, def] of Object.entries(dealFields)) {\n      if (!String(id).startsWith('UF_CRM_')) continue;\n      if (rawLabels(def, id).some(x => x.toLocaleLowerCase('tr-TR') === w)) return id;\n    }\n  }\n\n  // 3) Son çare normalize edilmiş tam eşleşme\n  const wantedNorm = [...exactLabels, ...fallbackNormalized].map(norm);\n  for (const [id, def] of Object.entries(dealFields)) {\n    if (!String(id).startsWith('UF_CRM_')) continue;\n    const labels = rawLabels(def, id).map(norm);\n    if (labels.some(x => wantedNorm.includes(x))) return id;\n  }\n\n  return '';\n}\n\nfunction coerceForField(id, value) {\n  const def = dealFields[id] || {};\n  if (def.type === 'double' || def.type === 'integer') {\n    return parseNumberTR(value);\n  }\n  return clean(value);\n}\n\nfunction putExact(fields, value, exactLabels, fallbackNormalized = []) {\n  if (!filled(value)) return '';\n  const id = fieldExact(exactLabels, fallbackNormalized);\n  if (!id) return '';\n  fields[id] = coerceForField(id, value);\n  return id;\n}\n\n// Anlaşma türü = XRE BARTER\nlet dealTypeId = '';\ntry {\n  const types = $('Bitrix Anlaşma Türlerini Oku').first().json.result || [];\n  const hit = types.find(x => norm(x.NAME) === 'XRE BARTER');\n  if (hit) dealTypeId = hit.STATUS_ID;\n} catch (e) {}\n\n// Kaynak = Sahibinden\nlet sourceId = '';\ntry {\n  const sources = $('Bitrix Kaynakları Oku').first().json.result || [];\n  const hit = sources.find(x => norm(x.NAME).includes('SAHIBINDEN'));\n  if (hit) sourceId = hit.STATUS_ID;\n} catch (e) {}\n\nlet title = [il, ilce, mahalle].filter(Boolean).join(' - ');\nif (!title) title = 'Yeni XRE Barter İlanı';\nif (ilanBasligi) title += ' - ' + ilanBasligi;\nif (ilanNo) title += ' (İlan No: ' + ilanNo + ')';\n\nconst fields = {\n  TITLE: title,\n  CATEGORY_ID: 30,\n  STAGE_ID: 'C30:UC_E2ZIWT',\n  ASSIGNED_BY_ID: assignedById,\n  OPPORTUNITY: parseNumberTR(fiyat),\n  CURRENCY_ID: 'TRY'\n};\n\nif (dealTypeId) fields.TYPE_ID = dealTypeId;\nif (sourceId) fields.SOURCE_ID = sourceId;\n\nconst mapped = {};\n\n// Ekranda gördüğümüz alanları birebir hedefle\nmapped.ilIlce = putExact(\n  fields,\n  [il, ilce].filter(Boolean).join(' / '),\n  ['İl / İlçe'],\n  ['IL ILCE']\n);\n\nmapped.mahalle = putExact(\n  fields,\n  mahalle,\n  ['Mahalle'],\n  ['MAHALLE']\n);\n\nmapped.ilanNo = putExact(\n  fields,\n  ilanNo,\n  ['İlan no', 'İlan No'],\n  ['ILAN NO']\n);\n\nmapped.resmiIlanLinki = putExact(\n  fields,\n  fullLink,\n  ['RESMİ İLAN LİNKİ', 'Resmi İlan Linki'],\n  ['RESMI ILAN LINKI']\n);\n\nmapped.kaynak = putExact(\n  fields,\n  'Sahibinden',\n  ['Kaynak'],\n  ['KAYNAK']\n);\n\nmapped.adaNo = putExact(\n  fields,\n  adaNo,\n  ['ADA NO:', 'ADA NO', 'Ada No'],\n  ['ADA NO']\n);\n\nmapped.parselNo = putExact(\n  fields,\n  parselNo,\n  ['PARSEL NO:', 'PARSEL NO', 'Parsel No'],\n  ['PARSEL NO']\n);\n\nmapped.m2 = putExact(\n  fields,\n  m2,\n  ['m²', 'M²'],\n  ['M2']\n);\n\nmapped.m2Fiyati = putExact(\n  fields,\n  m2Fiyati,\n  ['m² fiyatı', 'm² Fiyatı', 'M² FİYATI'],\n  ['M2 FIYATI']\n);\n\nmapped.tapuDurumu = putExact(\n  fields,\n  tapuDurumu,\n  ['Tapu Durumu', 'TAPU DURUMU'],\n  ['TAPU DURUMU']\n);\n\nmapped.fiyat = putExact(\n  fields,\n  fiyat,\n  ['Fiyat (TL)', 'FİYAT (TL)'],\n  ['FIYAT TL']\n);\n\n// Bunlar kartta varsa doldur\nmapped.ilanBasligi = putExact(fields, ilanBasligi, ['İlan Başlığı'], ['ILAN BASLIGI']);\nmapped.magazaAdi = putExact(fields, magazaAdi, ['Mağaza Adı'], ['MAGAZA ADI']);\nmapped.takas = putExact(fields, takas, ['Takas'], ['TAKAS']);\n\n// İlan linki artık SOURCE_DESCRIPTION / Kaynak bilgileri alanına yazılmıyor.\nfields.COMMENTS = [\n  `İlan No: ${ilanNo}`,\n  `İlan Başlığı: ${ilanBasligi}`,\n  `Fiyat (TL): ${fiyat}`,\n  `Ada No: ${adaNo}`,\n  `Parsel No: ${parselNo}`,\n  `m²: ${m2}`,\n  `m² Fiyatı: ${m2Fiyati}`,\n  `Tapu Durumu: ${tapuDurumu}`,\n  `Mağaza Adı: ${magazaAdi}`,\n  `İsim: ${isim}`,\n  `Telefon: ${phone.plus || telefonRaw}`,\n  `İl: ${il}`,\n  `İlçe: ${ilce}`,\n  `Mahalle: ${mahalle}`,\n  `Takas: ${takas}`,\n  `İlan Link: ${fullLink}`,\n  `Sorumlu Kişi: ${sorumlu.ad}`\n].join('\\n');\n\n// Mükerrer kontrolü için filtre (İlan No alanı, yoksa başlıktaki 'İlan No: X')\nlet dupFilter = { ID: 0 }; // İlan No yoksa kontrol yapılmaz\nif (ilanNo) {\n  dupFilter = mapped.ilanNo\n    ? { [mapped.ilanNo]: fields[mapped.ilanNo] }\n    : { '%TITLE': 'İlan No: ' + ilanNo + ')' };\n}\n\nreturn {\n  json: {\n    dupFilter,\n    ilanNo,\n    row_number: r.row_number || r['__rowNum__'] || 2,\n    adi,\n    soyadi,\n    telefonRaw,\n    assignedById,\n    sorumluAd: sorumlu.ad,\n    telefonPlus: phone.plus,\n    phoneValid: phone.valid,\n    dealTypeId,\n    sourceId,\n    mappedFieldIds: mapped,\n    body: {\n      fields,\n      params: { REGISTER_SONET_EVENT: 'Y' }\n    }\n  }\n};"
      },

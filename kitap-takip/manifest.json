{
  "manifest_version": 3,
  "name": "Kitap Takip",
  "version": "0.3.0",
  "description": "Kitabınızın satıldığı sitelerdeki stok, fiyat ve satış işaretlerini düzenli olarak kaydeder; değişiklikleri isterseniz Telegram'dan bildirir.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.hepsiburada.com/*",
    "https://www.amazon.com.tr/*",
    "https://1000kitap.com/*",
    "https://dostkitabevi.com/*",
    "https://www.dostkitabevi.com/*",
    "https://nobelkitap.com/*",
    "https://www.imge.com.tr/*",
    "https://www.e-kitapmedia.de/*",
    "https://www.bkmkitap.com/*",
    "https://www.kitapyurdu.com/*",
    "https://api.telegram.org/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Kitap Takip panelini aç" },
  "options_page": "dashboard.html"
}

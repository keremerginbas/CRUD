  {
    "type": "function",
    "function": {
      "name": "randevu_olustur",
      "description": "Müşteri randevu / projeyi yerinde görmek istediğini söyleyince HEMEN çağır. Gün ve saat SORULMAZ: randevu CRM'e saatsiz düşer, satış temsilcisi müşteriyi arayıp gün ve saati belirler.",
      "parameters": {
        "type": "object",
        "properties": {
          "ad_soyad": {
            "type": "string",
            "description": "Müşterinin adı soyadı, biliniyorsa."
          },
          "tercih_edilen_zaman": {
            "type": "string",
            "description": "Sadece müşteri KENDİLİĞİNDEN bir gün/saat söylediyse, söylediği gibi (örn. 'cumartesi öğleden sonra'). Gün veya saat SORMA."
          },
          "ilgilendigi_daire": {
            "type": "string",
            "enum": [
              "1+1",
              "2+1 A Tipi",
              "2+1 Ebeveyn Banyolu",
              "2+1 Bağımsız Mutfaklı",
              "belirsiz"
            ]
          },
          "odeme_tercihi": {
            "type": "string",
            "enum": [
              "nakit",
              "vadeli",
              "kredi",
              "kredi_karti",
              "belirsiz"
            ]
          },
          "not": {
            "type": "string",
            "description": "Satış temsilcisine kısa not: bütçe, özel istekler."
          }
        },
        "required": []
      }
    },
    "server": {
      "url": "https://N8N_ALANINIZ/webhook/efas-ntepe-outbound",
      "timeoutSeconds": 20
    },
    "messages": [
      {
        "type": "request-start",
        "content": "Hemen sisteme kaydediyorum, bir saniye lütfen."
      },
      {
        "type": "request-failed",
        "content": "Sistemde küçük bir sorun oldu; talebinizi not aldım, satış temsilcimiz sizi arayacak."
      }
    ]
  },

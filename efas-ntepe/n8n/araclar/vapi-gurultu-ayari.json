        "jsCode": "// Çevre gürültüsü ayarı: Krisp gürültü engelleme açılır; asistan ancak müşteri en az 1 KELİME söyleyince susar\n// (kelimesiz ses — trafik, TV, rüzgâr — konuşmayı kesmez).\nconst GOVDE = {\n  \"backgroundSpeechDenoisingPlan\": {\n    \"smartDenoisingPlan\": {\n      \"enabled\": true\n    }\n  },\n  \"stopSpeakingPlan\": {\n    \"numWords\": 1,\n    \"voiceSeconds\": 0.3,\n    \"backoffSeconds\": 1\n  }\n};\nreturn [\n  { json: { asistan: \"outbound\", id: \"010eabaa-0838-42b0-af4d-ba3a30a8373d\", govde: GOVDE } },\n  { json: { asistan: \"inbound\", id: \"b723ba5d-b1f4-4c97-bc5a-65a71317d85e\", govde: GOVDE } },\n];\n"
      },
      "id": "7b1c2f0e-1a11-4c8a-9a01-000000000002",
      "name": "Ayarlar",

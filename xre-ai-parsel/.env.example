# Yerel Express sunucusu (internete açmayın)
HOST=127.0.0.1
PORT=3001
# SQLite varsayılandır. MySQL kullanmıyorsanız DATABASE_URL TANIMLAMAYIN.
# SQLITE_PATH=./data/xre-parsel.sqlite

# public: dogrudan TKGM CBS (token olmadan ilk deneme)
# authorized: yalnızca yetkili erisiminiz varsa; token gerekir
TKGM_PARCEL_MODE=public
# Varsayilan public servis v3; calismiyorsa resmî kanallardan guncelligini kontrol edin
# TKGM_API_BASE=https://cbsapi.tkgm.gov.tr/megsiswebapi.v3/api
# TKGM_TOKEN yalnizca authorized modunda kullanilir; e-Devlet sifresi / oturum bilgisi girmeyin
TKGM_TOKEN=
# Koordinat sorgusunu kullanım koşullarını doğruladıktan sonra açın.
TKGM_COORDINATE_ENABLED=false
# Windows'ta Python Launcher (`py -3`) varsayılandır.
# Gerekirse Python'un python.exe dosyasına tam yolu yazın.
# PYTHON_BIN=C:\\Users\\Kullanici\\AppData\\Local\\Programs\\Python\\Python313\\python.exe

# AI modülü isteğe bağlıdır; ChatGPT aboneliğinden ayrı ücretlidir.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# V13: AI analizinde web araştırması (OpenAI web_search aracı; ek ücretlidir). Kapatmak için false.
AI_WEB_SEARCH=true

PORT=4000
# console: SMS göndermez, sadece loglar (test için). erccell / netgsm: gerçek gönderim.
SMS_PROVIDER=console
ERCCELL_USERNAME=
ERCCELL_PASSWORD=
# Erccell'de onaylı SMS başlığı (ör. XRE)
ERCCELL_HEADER=
ERCCELL_SMS_TYPE=UC
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Netgsm'de onaylı SMS başlığı (gönderici adı)
NETGSM_HEADER=
# 11: bireysel ticari ileti (İYS kontrollü), 12: tacir, boş: bilgilendirme amaçlı
NETGSM_IYS_FILTER=11
# /api/leads uç noktası için x-api-key başlığı
API_KEY=
SCHEDULER_INTERVAL_MS=60000
DB_FILE=

# ---- Bitrix24 ----
# Bitrix > Geliştirici kaynakları > Diğer > Gelen webhook (crm izinli). Örn: https://firma.bitrix24.com.tr/rest/1/abc123xyz/
BITRIX_WEBHOOK_URL=
# Giden webhook oluştururken Bitrix'in verdiği "uygulama anahtarı" (application_token)
BITRIX_APP_TOKEN=
# Projeyi tutan özel alan (ör. UF_CRM_1712345678). Projeler ayrı pipeline ise boş bırakın.
BITRIX_PROJECT_FIELD=
# SMS/İYS iznini tutan Bitrix alanı (Evet/Hayır). Boşsa BITRIX_DEFAULT_CONSENT kullanılır.
BITRIX_CONSENT_FIELD=
# true: Bitrix'ten gelen herkesin SMS izni var kabul edilir (İYS onaylı olduklarından emin olun)
BITRIX_DEFAULT_CONSENT=false

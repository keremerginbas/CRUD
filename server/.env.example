PORT=3000
# Uzun ve rastgele bir değer kullanın
JWT_SECRET=degistir-beni
DB_PATH=./data/santral.db

# Santral sağlayıcı: mock | verimor
PBX_PROVIDER=mock
# Santralin webhook isteklerini imzalamak için paylaşılan gizli anahtar
PBX_WEBHOOK_SECRET=degistir-beni
# 1 yapılırsa santralden gelen webhook gövdeleri loglanır (yeni santral bağlarken alan adlarını görmek için)
PBX_LOG_WEBHOOKS=0

# Verimor Bulut Santral
VERIMOR_API_KEY=
VERIMOR_BASE_URL=https://api.bulutsantralim.com


# Mesai dışı / müsait danışman yoksa çağrının gideceği karşılama grubu (444 hattının kuyruk dahilisi)
HUNT_GROUP_DESTINATION=queue:karsilama
# Müşteriye çalınacak anons (santral panelinde yüklenen ses dosyasının adı/id'si)
CUSTOMER_ANNOUNCEMENT=danismaniniz-sizi-ariyor

# Bitrix24: Geliştirici kaynakları → Gelen webhook (izinler: telephony, crm, user)
# Örnek: https://xre.bitrix24.com.tr/rest/1/xxxxxxxxxxxx
BITRIX_WEBHOOK_URL=
BITRIX_DEFAULT_USER_ID=

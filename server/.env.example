# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env git'e gönderilmez.

# demo = örnek veriler, live = gerçek siteler, ya da: obilet,enuygun,ucuzabilet,skyscanner
PROVIDERS=demo

# Yapay zekâ asistanı (isteğe bağlı). Anahtarı kimseyle paylaşmayın.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uygulama kapalıyken telefona bildirim için (isteğe bağlı): telefona "ntfy" uygulamasını kurup
# tahmin edilmesi zor bir konu adına abone olun ve aynı adı buraya yazın.
NTFY_TOPIC=

PORT=4000
CACHE_TTL_SEC=60

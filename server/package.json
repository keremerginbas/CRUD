{
  "name": "bilet-radar-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "obilet, enuygun, ucuzabilet ve skyscanner sonuçlarını tek API'de toplayan ve dolu/boşalan biletleri takip eden kişisel servis",

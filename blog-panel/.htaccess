# Panel, ana sitenin public_html klasörü içindeyse üst klasörün
# yönlendirme kurallarını devralmasın.
DirectoryIndex index.php
ErrorDocument 403 default
ErrorDocument 404 default
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

Options -Indexes
<FilesMatch "^(config\.php|config\.sample\.php|README\.md)$">
    Require all denied
</FilesMatch>

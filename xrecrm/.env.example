# Copy this file to .env. NEVER publish .env or place it in public/.
# Demo works without DATABASE_URL and without provider keys.
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Optional local MySQL/MariaDB persistence. Create the database first.
# DATABASE_URL=mysql://xrecrm_user:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:3306/xrecrm
DB_POOL_SIZE=10

# Live login currently uses Manus OAuth. These are NOT standalone-login settings.
# Do not copy the cloud JWT secret. Standalone email/password login is not included.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
XRE_OWNER_OPEN_ID=

# User-owned provider keys; keep blank unless securely configured locally.
XRE_OPENAI_API_KEY=
N8N_API_KEY=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_LINE_MAP_JSON=
VAPI_WEBHOOK_SECRET=
INBOUND_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_SECRET=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_LINE_MAP_JSON=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=
PBX_GATEWAY_URL=
PBX_GATEWAY_TOKEN=
BITRIX_DOMAIN=
BITRIX_WEBHOOK=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_KEY=
OUTBOX_INTERVAL_MS=5000

# Gerçek hat envanteri (numara/ICCID) Git'e girmez. config/lines.example.json
# biçiminde config/lines.json oluşturun veya JSON'u bu değişkene yazın.
# LINES_INVENTORY_FILE=config/lines.json
# LINES_INVENTORY_JSON=

# Webhook merkezi: kendi sunucunuzdaki n8n/PBX gibi iç ağ hedeflerine
# giden webhook izni (virgülle ayrılmış ana bilgisayar/IP). HTTP de kabul edilir.
# OUTBOUND_ALLOW_PRIVATE_HOSTS=10.0.0.5,n8n.internal

# --- v8: çoğu ayar artık Entegrasyonlar sayfasından girilir (şifreli saklanır) ---
# Oturum imza anahtarı boşsa data/session-secret otomatik oluşturulur.
# XRE_SESSION_SECRET=
# DATABASE_URL boşsa yerel dosya veritabanı: data/xrecrm-data.json
# XRE_DATA_DIR=data

# --- E-posta entegrasyonu (kullanıcılar posta kutusunu Profilim sayfasından bağlar; bkz. docs/eposta.md) ---
# Posta kutusu şifreleri XRE_SETTINGS_KEY (yoksa XRE_SESSION_SECRET) ile şifrelenir; anahtar değişirse yeniden bağlanmak gerekir.
# XRE_EMAIL_POLL=0                 # gelen kutusu yoklamasını kapatır (varsayılan: açık)
# XRE_EMAIL_POLL_SECONDS=120       # yoklama aralığı (60-3600 sn)
# XRE_EMAIL_SEND_PER_MINUTE=10     # kullanıcı başına dakikalık gönderim sınırı
# XRE_EMAIL_SEND_PER_DAY=200       # kullanıcı başına günlük gönderim sınırı

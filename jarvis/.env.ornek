# ===== JARVIS ayarları =====
# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyasını kimseyle paylaşmayın.

# Kısayol: Mac'te Ctrl+Option+J, Windows'ta Ctrl+Alt+J (uyandırır / konuşmayı ya da dinlemeyi bitirir)

# ElevenLabs: elevenlabs.io > sol alttaki profil > API Keys
ELEVENLABS_API_KEY=
# OpenAI: platform.openai.com > API keys (derin düşünme, internet araması, ekran, özet, hafıza için)
OPENAI_API_KEY=
# İsterseniz OpenAI yerine Claude: platform.claude.com > API Keys (ikisinden biri yeterli)
ANTHROPIC_API_KEY=

# Size nasıl hitap etsin (ör. Kerem)
JARVIS_KULLANICI_ADI=

# Ses: ElevenLabs'te beğendiğiniz sesin ID'si (Voices > sesin yanındaki ⋯ > Copy voice ID).
# Boş bırakılırsa "George" (tok, sakin erkek sesi) kullanılır.
JARVIS_SES_ID=

# Kulaklık kullanıyorsanız "evet": Jarvis konuşurken sesinizle sözünü kesebilirsiniz.
# Hoparlörde "hayir" kalsın: Jarvis konuşurken mikrofon kapanır, kendi sesini duyup kendine cevap vermez.
JARVIS_KULAKLIK=hayir

# Uyandırma hassasiyeti (0.4 daha kolay uyanır, 0.8 daha zor). Yanlışlıkla uyanıyorsa artırın,
# "Hey Jarvis" dediğinizde uyanmıyorsa azaltın.
JARVIS_UYANDIRMA_ESIGI=0.6

# Dinleme modunda bilgisayarın sesini de kaydet (Teams/Zoom'daki karşı tarafı da duyar).
# Mac'te BlackHole kurulu olmalı (README'ye bakın); yoksa yalnızca mikrofon kaydedilir.
JARVIS_BILGISAYAR_SESINI_KAYDET=evet

# --- İleri ayarlar (genelde dokunmayın) ---
# Düşünme motoru: openai ya da claude (boşsa hangi anahtar varsa o)
JARVIS_BEYIN=
# OpenAI modeli (virgülle birden fazla; hesabınızın erişebildiği ilki kullanılır)
JARVIS_OPENAI_MODELI=gpt-6.1-sol,gpt-5.5,gpt-5.4
# Canlı sohbet modeli (ElevenLabs çalıştırır, ElevenLabs kredisinden düşer; ek anahtar gerekmez).
# Daha hızlı cevap için: claude-sonnet-5-5 ya da gpt-5.5
JARVIS_SOHBET_MODELI=claude-opus-5-5
# Sohbet düşünme seviyesi: low (en akıcı) / medium / high. Zor sorular zaten derin düşünmeye gider.
JARVIS_SOHBET_EFOR=low
# Ses modeli: eleven_v3_conversational (en gerçekçi) ya da eleven_flash_v2_5 (en hızlı)
JARVIS_SES_MODELI=
# Dinleme modunda en uzun kayıt (dakika)
JARVIS_AZAMI_KAYIT_DK=120
